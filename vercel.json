{
  "crons": [
    {
      "path": "/api/threads-auto-post",
      "schedule": "30 11 * * *"
    },
    {
      "path": "/api/threads-auto-post?action=refresh-token",
      "schedule": "0 2 * * 1"
    }
  ],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/ads.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "cleanUrls": true,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/threads-auto-post",
      "has": [
        {
          "type": "query",
          "key": "action",
          "value": "recent-posts"
        }
      ],
      "destination": "/api/threads-recent-posts"
    }
  ],
  "redirects": [
    {
      "source": "/articles",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/monthly-saving-rate",
      "destination": "/blog/monthly-saving-rate",
      "permanent": true
    },
    {
      "source": "/cash-runway",
      "destination": "/blog/cash-runway",
      "permanent": true
    },
    {
      "source": "/travel-budget",
      "destination": "/blog/travel-budget",
      "permanent": true
    },
    {
      "source": "/investment-allocation",
      "destination": "/blog/investment-allocation",
      "permanent": true
    },
    {
      "source": "/financial-freedom",
      "destination": "/blog/financial-freedom",
      "permanent": true
    },
    {
      "source": "/wealth-tier",
      "destination": "/blog/wealth-tier",
      "permanent": true
    },
    {
      "source": "/same-age-savings",
      "destination": "/blog/same-age-savings",
      "permanent": true
    },
    {
      "source": "/fixed-expense-ratio",
      "destination": "/blog/fixed-expense-ratio",
      "permanent": true
    }
  ]
}
